# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=dx
POSTGRES_USER=dx
POSTGRES_PASSWORD=dx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Session / security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Backup encryption (AES-256-GCM archives)
BACKUP_DEFAULT_PASSWORD=

# Email (report distribution)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=dx-lis@example.org

# Shared secret for the instrument middleware, host query and inbound HL7
INSTRUMENT_INGEST_TOKEN=change-me

# Cache. The default is per-process local memory, which is WRONG for a
# multi-worker deployment: the API rate limiter counts there, so four gunicorn
# workers would allow four times each client's limit. `manage.py check` warns
# when this is left at the default outside DEBUG.
#   DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#   DJANGO_CACHE_LOCATION=redis://127.0.0.1:6379/1
# or, with no extra infrastructure:
#   DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
#   DJANGO_CACHE_LOCATION=dx_cache    (then: manage.py createcachetable)
DJANGO_CACHE_BACKEND=
DJANGO_CACHE_LOCATION=

# ── Two-factor authentication ────────────────────────────────────────────────
# TOTP (RFC 6238). Required by default for the roles that can change who else
# has access; widen or narrow with a comma-separated list of roles.
MFA_ENABLED=True
MFA_REQUIRED_ROLES=installer,admin

# ── Single sign-on (OpenID Connect) ──────────────────────────────────────────
# Off unless an issuer and client id are set. The installer account never
# authenticates through SSO — it is the break-glass account for the case where
# SSO itself is what has failed.
OIDC_ENABLED=False
OIDC_PROVIDER_NAME=your organisation account
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
OIDC_ROLE_CLAIM=groups
# {"directory group": "dx role"} — anything unmapped is refused, not guessed.
OIDC_ROLE_MAP={}
OIDC_DEFAULT_ROLE=
OIDC_PROVISION_USERS=False

# ── Business continuity ──────────────────────────────────────────────────────
# Where downtime packs are written. Concentrated patient data, deliberately
# readable without this application — put it on an encrypted volume the
# laboratory physically controls, and make sure it is reachable when this
# server is not.
DOWNTIME_PACK_DIR=

# ── Observability ────────────────────────────────────────────────────────────
# /metrics carries counts and states only, never identifiers. Leave the token
# unset only when the endpoint is bound to an interface the hospital network
# cannot reach. DJANGO_LOG_FORMAT=json emits one JSON object per line.
METRICS_TOKEN=
DJANGO_LOG_FORMAT=text

# How long a record stays reserved for the user who opened it, without contact
# from their browser. The open page refreshes this on a heartbeat; the value
# only matters when a browser closes without warning.
RECORD_LOCK_TTL_SECONDS=900

# Decision rules. Set to False to stop ALL automatic verification immediately,
# whatever any individual rule says — during a QC investigation, say. It does
# not relax any other control: the per-analyte opt-in on the test definition
# and every guardrail still apply when it is True.
RULES_ALLOW_AUTO_VERIFICATION=True

# Where encrypted GDPR subject-access exports are written. These are one
# person's entire medical record; put them somewhere with the access controls
# and retention you would give a paper copy.
SUBJECT_REQUEST_EXPORT_DIR=

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=dx
POSTGRES_USER=dx
POSTGRES_PASSWORD=dx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Session / security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Backup encryption (AES-256-GCM archives)
BACKUP_DEFAULT_PASSWORD=

# Email (report distribution)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=dx-lis@example.org

# Instrument middleware ingest shared secret
INSTRUMENT_INGEST_TOKEN=change-me
